# Copy to .env.local and fill in. Never commit .env.local.
# In production (Vercel), add these under Project > Settings > Environment Variables instead.

# Database. Leave empty locally (uses PGlite in ~/.invin/pglite).
# Production: Neon's pooled connection string; DATABASE_URL_UNPOOLED (direct) is used for migrations.
# The Neon integration on Vercel fills both in for you.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Resend (email delivery): https://resend.com/api-keys
RESEND_API_KEY=

# Test mode: every email goes to this address instead of the customer (use the email you signed up to Resend with)
EMAIL_REDIRECT_TO=
# Live mode: a sender on a domain verified in Resend, e.g. billing@yourdomain.com (clear EMAIL_REDIRECT_TO)
EMAIL_FROM=

# Links in emails and sign-in. Production: your site's address, e.g. https://invin.vercel.app
APP_URL=http://localhost:3000

# PDF rendering: path to Chrome or Chromium. Leave empty on Vercel (a serverless Chrome is used).
CHROME_PATH=

# Sign-in (Better Auth): a long random string, e.g. `openssl rand -hex 32`
BETTER_AUTH_SECRET=

# Production scheduler: Vercel Cron sends this automatically to /api/cron (once a day on Hobby).
# For timely receipts and reminders, also point a free cron service (e.g. cron-job.org) at
# <APP_URL>/api/cron every 5 minutes with the header "Authorization: Bearer <secret>".
CRON_SECRET=
