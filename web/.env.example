# Copy to .env.local and fill in. Never commit .env.local.

# Resend (email delivery): https://resend.com/api-keys
RESEND_API_KEY=

# Test mode: every email goes to this address instead of the customer (use the email you signed up to Resend with)
EMAIL_REDIRECT_TO=
# Live mode: a sender on a domain verified in Resend, e.g. billing@yourdomain.com (clear EMAIL_REDIRECT_TO)
EMAIL_FROM=

# Links in emails
APP_URL=http://localhost:3000

# PDF rendering: path to Chrome or Chromium
CHROME_PATH=

# Sign-in (Better Auth): a long random string, e.g. `openssl rand -hex 32`
BETTER_AUTH_SECRET=

# Production scheduler: the secret your cron sends as "Authorization: Bearer <secret>" to /api/cron
CRON_SECRET=
